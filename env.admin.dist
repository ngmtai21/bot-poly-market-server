# Env for the ADMIN process only (npm run admin). Copy to .env.admin — this
# file must NEVER contain PRIVATE_KEY, WALLET_KEY_DECRYPT_PRIVATE_KEY,
# CLOB_API_KEY/SECRET/PASSPHRASE, or CTF_*/COLLATERAL_TOKEN_ADDRESS. Those
# stay in .env.bot only — the admin process has no legitimate reason to read
# them (see CLAUDE.md "Two processes, one SQLite file").

# SQLite file shared with the bot process (which writes it via its own
# DB_PATH in .env.bot — both must point at the same path).
DB_PATH=data/bot.db

# Signs login sessions. Set explicitly so restarts don't invalidate every
# session (left unset, the process generates one at boot and warns — every
# session then drops on the next restart). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Keep on 127.0.0.1 and reach it via SSH tunnel — never expose publicly:
#   ssh -L 8787:127.0.0.1:8787 root@<vps>   then open http://localhost:8787
ADMIN_HOST=127.0.0.1
ADMIN_PORT=8787

# Optional Telegram alerts for admin-side events (logins, wallet-key
# rotation staged, bot heartbeat lost/recovered). Safe to reuse the same
# bot token/chat as .env.bot, just not the same file.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
