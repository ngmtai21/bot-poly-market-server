# EOA wallet private key used to sign/derive CLOB API credentials (Polygon)
PRIVATE_KEY=

# Polymarket CLOB API
CLOB_API_URL=https://clob.polymarket.com

# Filled in automatically by `npm run setup-api-key`
CLOB_API_KEY=
CLOB_API_SECRET=
CLOB_API_PASSPHRASE=

# Arbitrage thresholds.
# Polymarket charges a taker fee of fee = shares * feeRate * p * (1-p), with
# feeRate up to 0.07 (Crypto) depending on market category, peaking near
# p=0.5 — exactly where YES+NO tends to be closest to 1. MIN_PROFIT_MARGIN
# must clear the worst-case fee plus a buffer, or "profitable" opportunities
# are actually losses after fees. Do not lower this without accounting for
# per-market fee category (see README).
MIN_PROFIT_MARGIN=0.1
MAX_ORDER_SIZE_USDC=50

# Must be exactly "true" to place real orders. Leave unset/false to dry-run
# (opportunities are logged but no order is sent).
ENABLE_TRADING=false
