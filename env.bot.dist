# Env for the BOT process only (npm run scan). Copy to .env.bot — never
# .env.admin, never anywhere the admin process could read it.

# EOA wallet private key used to sign/derive CLOB API credentials (Polygon).
# Optional if you'll stage a key from the admin panel instead (see
# WALLET_KEY_DECRYPT_PRIVATE_KEY below and README "Rotating the wallet key")
# — the bot then never needs a plaintext key sitting in this file.
PRIVATE_KEY=

# Base64-encoded RSA private key (PKCS8 PEM), printed by `npm run setup-admin`.
# Lets the bot decrypt a wallet key staged from the admin panel; the admin
# panel itself only ever holds the matching PUBLIC key (stored in the db),
# so it can encrypt a new key but never read one back.
WALLET_KEY_DECRYPT_PRIVATE_KEY=

# Polymarket CLOB API
CLOB_API_URL=https://clob.polymarket.com

# Filled in automatically by `npm run setup-api-key`
CLOB_API_KEY=
CLOB_API_SECRET=
CLOB_API_PASSPHRASE=

# Arbitrage thresholds.
# The scanner already subtracts Polymarket's real taker fee per market (via
# client.getFeeRateBps, see src/feeRate.ts) before comparing against this
# threshold — margin here is NET of fees, not the raw YES+NO spread.
# MIN_PROFIT_MARGIN is the "worth logging" bar — low, so paper-trades.jsonl
# captures how often opportunities occur at all. EXECUTE_MARGIN_THRESHOLD is
# the higher "worth actually risking capital" bar — opportunities between the
# two are recorded but never executed, even with ENABLE_TRADING=true, since
# this bot isn't the fastest in the race and thin margins are likely eaten by
# slippage/latency before the order lands.
MIN_PROFIT_MARGIN=0.01
EXECUTE_MARGIN_THRESHOLD=0.05
MAX_ORDER_SIZE_USDC=50

# Must be exactly "true" to place real orders. Leave unset/false to dry-run
# (opportunities are logged but no order is sent).
ENABLE_TRADING=false

# Claiming/redeeming winnings after a market resolves (npm run redeem) — an
# on-chain transaction, separate from the CLOB order API. Left empty on
# purpose: verify these addresses yourself before setting them (see README
# "Claiming winnings"). Do not copy these from an AI response or a random
# webpage — a wrong address can burn your tokens with no payout.
CTF_ADAPTER_ADDRESS=
NEG_RISK_CTF_ADAPTER_ADDRESS=
COLLATERAL_TOKEN_ADDRESS=

# SQLite file shared with the admin process (which reads it via its own
# DB_PATH in .env.admin — both must point at the same path).
DB_PATH=data/bot.db

# Optional Telegram alerts for bot-side events (trade failures/unwinds).
# Admin-side events (logins, heartbeat loss) are configured separately in
# .env.admin — safe to use the same bot token/chat in both, just not the
# same file.
# Create a bot via @BotFather, then message it once and fetch your chat id:
#   curl https://api.telegram.org/bot<token>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# `npm run backup` snapshots DB_PATH into BACKUP_DIR, keeping the last
# BACKUP_KEEP copies. Schedule it with cron using this same env file:
#   0 * * * *  cd /path/to/server && npm run backup >> backup.log 2>&1
BACKUP_DIR=backups
BACKUP_KEEP=48
